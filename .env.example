# ==============================================================================
# ECHOES OF SMASC '26 (P-GALLERY) — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` in the project root: `cp .env.example .env`
# 2. Configure variables based on your deployment environment.

# ==============================================================================
# 1. CORE APPLICATION & SECURITY
# ==============================================================================
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-this-to-a-secure-50-character-random-secret-key
DJANGO_ALLOWED_HOSTS=yourdomain.edu.in,www.yourdomain.edu.in
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.edu.in,https://www.yourdomain.edu.in

# HTTPS & Security Hardening (Enable when domain has SSL/TLS active)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True

# ==============================================================================
# 2. DATABASE CONFIGURATION
# ==============================================================================
# Option A: Local / Development SQLite (Default if no DB_HOST or DATABASE_URL is set)
# (Leave DB_* blank to automatically use local db.sqlite3)

# Option B: Direct Connection URL (e.g. Render / Railway / Heroku PostgreSQL)
# DATABASE_URL=postgres://user:password@host:5432/database_name

# Option C: Explicit PostgreSQL Variables (e.g. Docker Compose)
DB_HOST=db
DB_PORT=5432
DB_NAME=pgallery
DB_USER=postgres
DB_PASSWORD=postgres
DB_CONN_MAX_AGE=600

# ==============================================================================
# 3. MEDIA & OBJECT STORAGE (Optional S3 / Cloudflare R2 / MinIO)
# ==============================================================================
# Set USE_S3=True to enable S3-compatible cloud storage instead of local volume
USE_S3=False
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_STORAGE_BUCKET_NAME=pgallery-media
# AWS_S3_REGION_NAME=auto
# AWS_S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=media.yourdomain.edu.in

# ==============================================================================
# 4. GUNICORN APPLICATION SERVER
# ==============================================================================
GUNICORN_HOST=0.0.0.0
PORT=8000
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=info

# ==============================================================================
# 5. UPLOAD & MEMORY LIMITS
# ==============================================================================
MAX_IMAGE_UPLOAD_SIZE=26214400      # 25 MB
MAX_VIDEO_UPLOAD_SIZE=524288000     # 500 MB
DATA_UPLOAD_MAX_MEMORY_SIZE=52428800 # 50 MB
FILE_UPLOAD_MAX_MEMORY_SIZE=52428800 # 50 MB

# ==============================================================================
# 6. EMAIL & CONTACT NOTIFICATIONS
# ==============================================================================
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=admin@yourdomain.edu.in
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Echoes Of SMASC <noreply@yourdomain.edu.in>
CONTACT_NOTIFICATION_EMAIL=admin@yourdomain.edu.in