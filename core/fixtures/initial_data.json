{
  "model": "core.aboutpage",
  "pk": 1,
  "fields": {
    "story_badge": "THE ARCHIVE STORY",
    "story_title": "Three Years. Countless Memories. One Story.",
    "story_paragraph_1": "College Memories ’26 is a digital archive created to preserve the people, journeys, celebrations and everyday moments that defined our three years of college life.",
    "story_paragraph_2": "It is more than a gallery of photographs. It is a collection of friendships, laughter, lessons and memories that will continue to stay with us long after graduation.",
    "story_paragraph_3": "Built as a lightweight and permanent digital archive, this platform allows every member of our batch to revisit our journey anytime and anywhere.",
    "story_image": "about/IMG_6280.JPG.jpeg",
    "story_image_alt": "BCA Class of 2026 final group photo",
    "class_info_title": "Class Information",
    "class_info_text": "Bachelor of Computer Applications (BCA)\r\nClass of 2026\r\nThree years of friendship and memories",
    "archive_title": "The Archive",
    "archive_text": "A photography gallery, video collection, timeline, digital scrapbook and student yearbook.",
    "accessibility_title": "Accessible Anywhere",
    "accessibility_text": "Designed to remain fast, responsive and accessible across mobile phones, tablets, laptops and desktops.",
    "creator_name": "Manoj Kumar S",
    "creator_role": "Lead Developer & Creator",
    "creator_description": "Designed and developed for the BCA Class of 2026 to preserve our college memories in a clean, responsive and lasting digital archive.",
    "creator_image": "about/pfp.jpeg",
    "creator_image_alt": "Manoj Kumar S",
    "created_for_text": "Created for: BCA Class of 2026",
    "thanks_badge": "GRATITUDE & ACKNOWLEDGEMENT",
    "thanks_title": "Special Thanks",
    "thanks_text": "We extend our heartfelt gratitude to our HOD, faculty members, class coordinators, mentors and every classmate who contributed photographs, videos, captions and memories to this archive.",
    "updated_at": "2026-08-21T17:31:21.705Z",
